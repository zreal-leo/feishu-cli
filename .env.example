# Required. Fill these with your own values.
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional. Set a custom Claude API base URL (e.g. a proxy or relay endpoint).
ANTHROPIC_BASE_URL=
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx

# Optional. Fill this only if your Lark event subscription enables encryption.
LARK_ENCRYPT_KEY=

# optional. fill these only when using the "创建会议" command.
MANAGER_LOGIN_NAME=
MANAGER_PASSWORD=

# Optional. Fill these only when using the "cursor" command.
CURSOR_USAGE_TEAM_ID=
CURSOR_USAGE_USER_ID=
CURSOR_USAGE_COOKIE=

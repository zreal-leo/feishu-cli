CURSOR_API_KEY=cursor_xxx
CURSOR_MODEL=gpt-5.4

FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Optional. Fill this only if your Feishu event subscription enables encryption.
FEISHU_ENCRYPT_KEY=

# Optional. test uses https://testserver.comein.cn/comein/manager, prod uses https://server.comein.cn/comein/manager.
ENV=test
MANAGER_BASE_URL=

# Prefer a logged-in manager token. If omitted, the bot tries the verifyCode login variables below when creating a meeting.
MANAGER_TOKEN=
MANAGER_LOGIN_NAME=
MANAGER_PASSWORD=
MANAGER_LOGIN_ID=
MANAGER_CODE=

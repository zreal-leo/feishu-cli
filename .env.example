CURSOR_API_KEY=cursor_xxx
CURSOR_MODEL=gpt-5.4

FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# Optional. Fill this only if your Feishu event subscription enables encryption.
FEISHU_ENCRYPT_KEY=

# Optional. Used when Feishu receives "创建会议" or "/meeting".
# ENV defaults to test. Set ENV=prod to use the production manager backend.
ENV=test
MANAGER_TOKEN=

# Optional fallback when MANAGER_TOKEN is empty.
MANAGER_LOGIN_NAME=
MANAGER_PASSWORD=
MANAGER_LOGIN_ID=
MANAGER_CODE=

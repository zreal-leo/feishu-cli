# Required. Fill these with your own values.
AI_API_KEY=sk-ant-xxx

# Optional. Set a custom AI API base URL (e.g. a proxy or relay endpoint).
AI_BASE_URL=
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=xxx

# Optional. Fill this only if your Lark event subscription enables encryption.
LARK_ENCRYPT_KEY=

# optional. fill these only when using the "创建会议" command.
MANAGER_LOGIN_NAME=
MANAGER_PASSWORD=

# Optional. Enable the Friday weekly commit report scheduler.
WEEKLY_REPORT_CHAT_ID=

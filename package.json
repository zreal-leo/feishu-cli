{
    "name": "lark-cli",
    "version": "0.1.0",
    "description": "A local Lark bot process that routes text messages to built-in commands or Cursor fallback replies.",
    "private": true,
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "dev": "tsx src/index.ts",
        "start": "pnpm build && node dist/index.js",
        "test": "tsx --test test/**/*.test.ts",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-service.ps1 status",
        "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-service.ps1 stop",
        "service:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-service.ps1 start"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.115.0",
        "@larksuiteoapi/node-sdk": "^1.72.0",
        "dotenv": "^17.4.2"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "esbuild": "^0.28.1",
        "oxfmt": "^0.62.0",
        "tsx": "^4.22.4",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
